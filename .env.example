# LLM (required) - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# News search (optional) - https://newsapi.org/
# If unset, the News tool returns clearly-labelled mock data.
NEWS_API_KEY=

# Weather (optional) - https://openweathermap.org/api
# If unset, the Weather tool falls back to Open-Meteo (free, no key required).
OPENWEATHER_API_KEY=

# Traffic (optional) - https://developer.tomtom.com/
# If unset, the Traffic tool returns a clearly-labelled mock/demo response.
TOMTOM_API_KEY=

# App
LOG_LEVEL=INFO
